SECTIONS
{
    /* A generic .uninitialized_data record lives near 0x20000110, where the
     * bootloader copies its .data on every reset. Keep diagnostics in their
     * own NOLOAD bank, excluded from both the app heap and its main stack. */
    .pce_diag_retained (NOLOAD):
    {
        KEEP(*(.pce_diag_retained))
    } > PCE_DIAG_RAM

    /* .stack*_dummy section doesn't contains any symbols. It is only
     * used for linker to calculate size of stack sections, and assign
     * values to stack symbols later
     *
     * stack1 section may be empty/missing if platform_launch_core1 is not used */

    /* PicoPCE override: core1 stack stays in SCRATCH_X (4 KB), but the core0
     * main stack moves from SCRATCH_Y into the dedicated STACK region carved
     * from the top of main RAM (20 KB). See memory_extra.incl. */
    .stack1_dummy (NOLOAD):
    {
        *(.stack1*)
    } > SCRATCH_X
    .stack_dummy (NOLOAD):
    {
        KEEP(*(.stack*))
    } > STACK
}
